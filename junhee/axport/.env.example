# AXPORT 환경변수 예시 (CONTRIBUTING §6)
#
# 이 파일에는 변수명·설명·비밀이 아닌 예시만 둔다. 실제 값을 넣지 않는다.
# 복사해서 .env 로 쓴다. .env 는 Git 에 올리지 않는다.
#
#   cp .env.example .env
#
# ★ API 키는 이 파일에 넣지 않는다.
#   키는 api-vault 에서만 관리한다. api-vault/API_KEYS_FORM.txt 에 입력하고
#   api-vault/scripts/build_env.py 로 반영한 뒤,
#   api_keys.get_key / require_key 로만 읽는다. (명세서 §10)

# ── 실행 환경 ─────────────────────────────────────────────────────────
# development | test | production
AXPORT_RUNTIME__ENV=development
AXPORT_RUNTIME__HOST=127.0.0.1
AXPORT_RUNTIME__PORT=8000

# ── 설정 파일 위치 ────────────────────────────────────────────────────
# 비우면 config/settings.toml 을 쓴다. 절대경로를 하드코딩하지 않는다.
AXPORT_CONFIG_FILE=

# ── api-vault 참조 경로 ───────────────────────────────────────────────
# 프로젝트 루트 기준 상대경로. 기본값은 config/settings.toml 의
# storage.api_vault_dir(= ../api-vault). api-vault 를 수정하지 않는다.
AXPORT_STORAGE__API_VAULT_DIR=../api-vault

# ── 데모 모드 ─────────────────────────────────────────────────────────
# true 인 동안 실제 기업 자료를 받지 않는다. (명세서 §10)
AXPORT_FEATURES__DEMO_MODE=true

# ── 참고 ──────────────────────────────────────────────────────────────
# 설정값의 단일 출처는 config/settings.toml 이다.
# 환경변수는 배포 환경별 덮어쓰기용이며, 형식은 AXPORT_<섹션>__<키> 다.
# 환경변수를 추가·변경하면 이 파일과 README, 설정 검증을 함께 고친다.
