# api-vault 환경변수 목록 — 변수명과 설명만. 실제 키는 절대 넣지 않습니다.
# 실제 키는 API_KEYS_FORM.txt 에 입력 후 `python scripts/build_env.py` 로 생성됩니다.

# 공공데이터포털 인증키 (관세청·KOTRA·해수부 공통)
DATA_GO_KR_API_KEY=
# 한국은행 ECOS 통계
ECOS_API_KEY=
# 한국수출입은행 환율 (ECOS와 중복, 선택)
KOREAEXIM_API_KEY=
# 관세청 UNI-PASS 화물통관
UNIPASS_API_KEY=
# UN Comtrade (일 500회)
COMTRADE_API_KEY=
# US Census 무역통계
CENSUS_API_KEY=
# WTO Timeseries
WTO_API_KEY=
# US ITA — CSL + FTA Tariff (헤더 subscription-key)
TRADE_GOV_API_KEY=
# NewsData.io
NEWSDATA_API_KEY=
# NewsAPI.org
NEWSAPI_ORG_KEY=
# 금융감독원 전자공시
OPENDART_API_KEY=
# 해외 주식 시세
FINNHUB_API_KEY=
# 해외 시세 보조
ALPHAVANTAGE_API_KEY=
# 선택
TWELVEDATA_API_KEY=
# openai 또는 anthropic — 이름만. 키를 넣지 마세요
LLM_PROVIDER=
# Anthropic Messages API
ANTHROPIC_API_KEY=
# OpenAI API
OPENAI_API_KEY=
# 법제처 OC값 = 이메일ID @ 앞부분
LAW_GO_KR_OC=
